@Library('my-shared-library') _

pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                script {
                    myLibrary.buildApp()
                }
            }
        }
          stage('Create SonarQube Project') {
             steps {
                  script {
                     codeQuality.sonarCreateProject(env.JOB_NAME)
               }
          }
        }

        stage('SonarQube Scan') {
             steps {
                  script {
                    codeQuality.sonarLocalScan()
                }
         }
        }

        stage('Deploy') {
            steps {
                script {
                    myLibrary.deployApp()
                }
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    myLibrary.cleanup()
                }
            }
        }
    }
}